JOB_AGENT_ENVIRONMENT=development
JOB_AGENT_LOG_LEVEL=INFO
# MySQL database and credentials. The database must already exist.
JOB_AGENT_MYSQL_HOST=127.0.0.1
JOB_AGENT_MYSQL_PORT=3306
JOB_AGENT_MYSQL_DATABASE=job_agent
JOB_AGENT_MYSQL_USER=job_agent
JOB_AGENT_MYSQL_PASSWORD=replace-with-a-strong-password
# Used only by the Docker Compose MySQL service.
JOB_AGENT_MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
JOB_AGENT_MYSQL_CONNECT_TIMEOUT=10
JOB_AGENT_CANDIDATE_PROFILE=data/candidate_profile.json
JOB_AGENT_GENERATED_DOCUMENTS=data/generated_documents
JOB_AGENT_SEARCH_ENABLED=false
# Public archive-index discovery and Greenhouse board validation are opt-in.
JOB_AGENT_COMPANY_CRAWLER_ENABLED=true
JOB_AGENT_COMPANY_CRAWLER_SCAN_LIMIT=5000
JOB_AGENT_COMPANY_CRAWLER_CONCURRENCY=5
# Minimum idle time between every crawler HTTP request, including board checks.
JOB_AGENT_COMPANY_CRAWLER_REQUEST_DELAY_SECONDS=1
# Do not revisit a board until this many hours have elapsed (168 = 7 days).
JOB_AGENT_COMPANY_CRAWLER_REVISIT_INTERVAL_HOURS=168
# Two-letter code used to validate remote-job country eligibility.
JOB_AGENT_REMOTE_COUNTRY=us

# Criteria-based discovery sources. Configure at least one.
JOB_AGENT_ADZUNA_APP_ID=
JOB_AGENT_ADZUNA_APP_KEY=
JOB_AGENT_ADZUNA_COUNTRY=us
JOB_AGENT_REMOTIVE_ENABLED=false
JOB_AGENT_USAJOBS_EMAIL=
JOB_AGENT_USAJOBS_API_KEY=
# LinkedIn discovery through the schema-compatible Apify Actor below.
JOB_AGENT_LINKEDIN_ENABLED=false
JOB_AGENT_APIFY_API_TOKEN=
JOB_AGENT_APIFY_LINKEDIN_ACTOR_ID=automation-lab/linkedin-jobs-scraper
JOB_AGENT_APIFY_TIMEOUT_SECONDS=120

# Optional supplemental company sources (semicolon-separated Company=value entries).
JOB_AGENT_GREENHOUSE_BOARDS=
JOB_AGENT_LEVER_SITES=
# Workday values are tenant-specific public CXS base URLs.
JOB_AGENT_WORKDAY_TENANTS=
# Career page values are public URLs containing JobPosting JSON-LD.
JOB_AGENT_CAREER_PAGES=

JOB_AGENT_BROWSER_FALLBACK=none
JOB_AGENT_HTTP_TIMEOUT_SECONDS=20
JOB_AGENT_HTTP_USER_AGENT=JobAgent/0.3 (+local-job-search)
OPENAI_API_KEY=
